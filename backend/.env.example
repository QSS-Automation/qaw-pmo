# ── App ───────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
ENVIRONMENT=development
DATABASE_URL=sqlite:///./qaw_pm.db
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Company MySQL — Upcoming Projects feed (read-only) ────────────────────────
MYSQL_HOST=10.1.10.26        # MySQL server IP (the one shown in DBeaver)
MYSQL_PORT=3306
MYSQL_USER=your_mysql_username
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=curated_CRM   # the database containing curated_deals table

# ── SSH tunnel (fill these in — required because MySQL is behind a jump server)
# These match the SSH settings you entered in DBeaver
SSH_HOST=your_ssh_jump_server_ip_or_hostname
SSH_PORT=22
SSH_USER=your_ssh_username
SSH_PASSWORD=your_ssh_password
# SSH_KEY_FILE=./id_rsa      # alternative: path to private key file

# ── PMO MySQL (raw_pmo — plan/actual project data) ────────────────────────────
# Uses the same SSH tunnel as the CRM connection above
PMO_MYSQL_HOST=10.1.10.26
PMO_MYSQL_PORT=3306
PMO_MYSQL_USER=your_username
PMO_MYSQL_PASSWORD=your_password
PMO_MYSQL_DATABASE=raw_pmo

# ── SMTP (invitation emails) ───────────────────────────────────────────────────
# Leave SMTP_HOST empty to skip email sending entirely — invitations still get
# created, Admin just copies the link manually from the Invitations tab.
# Works with any standard SMTP provider — a few common ones:
#   Gmail:            smtp.gmail.com, port 587 — use an "app password", not your real one
#   Outlook/365:       smtp.office365.com, port 587
#   Your company mail server, or a transactional service (SendGrid/Mailgun SMTP relay)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=PM Ecosystem
# The link put inside the invitation email — set this to wherever the frontend
# is actually deployed (e.g. https://your-company-pm.com)
APP_BASE_URL=http://localhost:5173
