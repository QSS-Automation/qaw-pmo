# ── SMTP (invitation emails) ───────────────────────────────────────────────────
# Leave SMTP_HOST empty to skip email sending entirely — invitations still get
# created, Admin just copies the link manually from the Invitations tab.
# Works with any standard SMTP provider — a few common ones:
#   Gmail:            smtp.gmail.com, port 587 — use an "app password", not your real one
#   Outlook/365:       smtp.office365.com, port 587
#   Your company mail server, or a transactional service (SendGrid/Mailgun SMTP relay)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=qss-automation@quandatics.com
SMTP_PASSWORD=Q%389205904505ata3
SMTP_FROM_EMAIL=qss-automation@quandatics.com
SMTP_FROM_NAME=QAW PM Ecosystem
# The link put inside the invitation email — set this to wherever the frontend
# is actually deployed (e.g. https://qaw-pm.yourcompany.com)
APP_BASE_URL=http://localhost:5173